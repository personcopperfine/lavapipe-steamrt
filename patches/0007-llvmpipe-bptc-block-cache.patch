+#define LP_BPTC_CACHE_SIZE 1024
+#define LP_BPTC_FCACHE_SIZE 256
+
+struct lp_bptc_cache {
+   unsigned epoch;
+   unsigned tag_epoch[LP_BPTC_CACHE_SIZE];
+   const uint8_t *tag[LP_BPTC_CACHE_SIZE];
+   uint8_t rgba[LP_BPTC_CACHE_SIZE][16][4];
+   unsigned ftag_epoch[LP_BPTC_FCACHE_SIZE];
+   const uint8_t *ftag[LP_BPTC_FCACHE_SIZE];
+   bool fsigned[LP_BPTC_FCACHE_SIZE];
+   float frgba[LP_BPTC_FCACHE_SIZE][16][4];
+};
+
+static __thread struct lp_bptc_cache *lp_bptc_tls;
+
+unsigned
+lp_build_bptc_flags(void)
+{
+   static int flags = -1;
+
+   if (flags < 0) {
+      const char *e = getenv("LP_BPTC");
+      flags = e ? atoi(e) : 3;
+   }
+   return flags;
+}
+
+void
+lp_build_bptc_cache_reset(void)
+{
+   struct lp_bptc_cache *c = lp_bptc_tls;
+
+   if (c && ++c->epoch == 0) {
+      memset(c->tag_epoch, 0, sizeof(c->tag_epoch));
+      memset(c->ftag_epoch, 0, sizeof(c->ftag_epoch));
+      c->epoch = 1;
+   }
+}
+
+static inline struct lp_bptc_cache *
+lp_bptc_cache_get(void)
+{
+   struct lp_bptc_cache *c = lp_bptc_tls;
+
+   if (!(lp_build_bptc_flags() & 1))
+      return NULL;
+   if (unlikely(!c)) {
+      c = calloc(1, sizeof(*c));
+      if (c)
+         c->epoch = 1;
+      lp_bptc_tls = c;
+   }
+   return c;
+}
+
+static inline unsigned
+lp_bptc_slot(const uint8_t *src, unsigned size)
+{
+   uintptr_t a = (uintptr_t)src >> 4;
+
+   return (unsigned)(a ^ (a >> 10)) & (size - 1);
+}
+
+static inline void
+lp_bptc_unorm_texel(uint8_t dst[4], const uint8_t *src, unsigned i, unsigned j)
+{
+   struct lp_bptc_cache *c = lp_bptc_cache_get();
+   unsigned t = (j & 3) * 4 + (i & 3);
+
+   if (unlikely(!c)) {
+      uint8_t blk[16][4];
+      util_format_bptc_rgba_unorm_unpack_rgba_8unorm(&blk[0][0], 16, src, 16, 4, 4);
+      memcpy(dst, blk[t], 4);
+      return;
+   }
+
+   unsigned s = lp_bptc_slot(src, LP_BPTC_CACHE_SIZE);
+   if (c->tag[s] != src || c->tag_epoch[s] != c->epoch) {
+      util_format_bptc_rgba_unorm_unpack_rgba_8unorm(&c->rgba[s][0][0], 16, src, 16, 4, 4);
+      c->tag[s] = src;
+      c->tag_epoch[s] = c->epoch;
+   }
+   memcpy(dst, c->rgba[s][t], 4);
+}
+
+static void
+lp_bptc_fetch_rgba_8unorm(uint8_t *restrict dst, const uint8_t *restrict src,
+                          unsigned i, unsigned j)
+{
+   lp_bptc_unorm_texel(dst, src, i, j);
+}
+
+static void
+lp_bptc_unorm_fetch_rgba(void *restrict dst, const uint8_t *restrict src,
+                         unsigned i, unsigned j)
+{
+   float *d = dst;
+   uint8_t t[4];
+
+   lp_bptc_unorm_texel(t, src, i, j);
+   for (unsigned k = 0; k < 4; k++)
+      d[k] = ubyte_to_float(t[k]);
+}
+
+static void
+lp_bptc_srgba_fetch_rgba(void *restrict dst, const uint8_t *restrict src,
+                         unsigned i, unsigned j)
+{
+   float *d = dst;
+   uint8_t t[4];
+
+   lp_bptc_unorm_texel(t, src, i, j);
+   for (unsigned k = 0; k < 3; k++)
+      d[k] = util_format_srgb_8unorm_to_linear_float(t[k]);
+   d[3] = ubyte_to_float(t[3]);
+}
+
+static inline void
+lp_bptc_float_texel(float *dst, const uint8_t *src, unsigned i, unsigned j,
+                    bool is_signed)
+{
+   struct lp_bptc_cache *c = lp_bptc_cache_get();
+   unsigned t = (j & 3) * 4 + (i & 3);
+
+   if (unlikely(!c)) {
+      if (is_signed)
+         util_format_bptc_rgb_float_fetch_rgba(dst, src, i & 3, j & 3);
+      else
+         util_format_bptc_rgb_ufloat_fetch_rgba(dst, src, i & 3, j & 3);
+      return;
+   }
+
+   unsigned s = lp_bptc_slot(src, LP_BPTC_FCACHE_SIZE);
+   if (c->ftag[s] != src || c->ftag_epoch[s] != c->epoch ||
+       c->fsigned[s] != is_signed) {
+      if (is_signed)
+         util_format_bptc_rgb_float_unpack_rgba_float(&c->frgba[s][0][0], 64, src, 16, 4, 4);
+      else
+         util_format_bptc_rgb_ufloat_unpack_rgba_float(&c->frgba[s][0][0], 64, src, 16, 4, 4);
+      c->ftag[s] = src;
+      c->ftag_epoch[s] = c->epoch;
+      c->fsigned[s] = is_signed;
+   }
+   memcpy(dst, c->frgba[s][t], 16);
+}
+
+static void
+lp_bptc_float_fetch_rgba(void *restrict dst, const uint8_t *restrict src,
+                         unsigned i, unsigned j)
+{
+   lp_bptc_float_texel(dst, src, i, j, true);
+}
+
+static void
+lp_bptc_ufloat_fetch_rgba(void *restrict dst, const uint8_t *restrict src,
+                          unsigned i, unsigned j)
+{
+   lp_bptc_float_texel(dst, src, i, j, false);
+}
+
+static util_format_fetch_rgba_func_ptr
+lp_bptc_fetch_rgba_func(enum pipe_format format)
+{
+   if (!(lp_build_bptc_flags() & 2))
+      return util_format_fetch_rgba_func(format);
+   switch (format) {
+   case PIPE_FORMAT_BPTC_RGBA_UNORM:
+      return lp_bptc_unorm_fetch_rgba;
+   case PIPE_FORMAT_BPTC_SRGBA:
+      return lp_bptc_srgba_fetch_rgba;
+   case PIPE_FORMAT_BPTC_RGB_FLOAT:
+      return lp_bptc_float_fetch_rgba;
+   case PIPE_FORMAT_BPTC_RGB_UFLOAT:
+      return lp_bptc_ufloat_fetch_rgba;
+   default:
+      return util_format_fetch_rgba_func(format);
+   }
+}
